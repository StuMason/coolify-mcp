{
  "name": "application",
  "description": "Manage app: create/update/delete/delete_preview",
  "annotations": {
    "destructiveHint": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create_public",
          "create_github",
          "create_key",
          "create_dockerimage",
          "create_dockerfile",
          "update",
          "delete",
          "delete_preview"
        ]
      },
      "uuid": {
        "type": "string"
      },
      "project_uuid": {
        "type": "string"
      },
      "server_uuid": {
        "type": "string"
      },
      "github_app_uuid": {
        "type": "string"
      },
      "private_key_uuid": {
        "type": "string"
      },
      "destination_uuid": {
        "type": "string"
      },
      "git_repository": {
        "type": "string"
      },
      "git_branch": {
        "type": "string"
      },
      "environment_name": {
        "type": "string"
      },
      "environment_uuid": {
        "type": "string"
      },
      "build_pack": {
        "type": "string"
      },
      "ports_exposes": {
        "type": "string"
      },
      "docker_registry_image_name": {
        "type": "string"
      },
      "docker_registry_image_tag": {
        "type": "string"
      },
      "dockerfile": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "fqdn": {
        "type": "string"
      },
      "domains": {
        "type": "string"
      },
      "custom_docker_run_options": {
        "type": "string"
      },
      "custom_labels": {
        "type": "string"
      },
      "custom_network_aliases": {
        "description": "Comma-separated DNS aliases for app-to-app traffic (update only). App containers have no stable uuid hostname — only databases do.",
        "type": "string"
      },
      "instant_deploy": {
        "type": "boolean"
      },
      "health_check_enabled": {
        "type": "boolean"
      },
      "health_check_path": {
        "type": "string"
      },
      "health_check_port": {
        "type": "number"
      },
      "health_check_host": {
        "type": "string"
      },
      "health_check_method": {
        "type": "string"
      },
      "health_check_return_code": {
        "type": "number"
      },
      "health_check_scheme": {
        "type": "string"
      },
      "health_check_response_text": {
        "type": "string"
      },
      "health_check_interval": {
        "type": "number"
      },
      "health_check_timeout": {
        "type": "number"
      },
      "health_check_retries": {
        "type": "number"
      },
      "health_check_start_period": {
        "type": "number"
      },
      "base_directory": {
        "type": "string"
      },
      "publish_directory": {
        "type": "string"
      },
      "install_command": {
        "type": "string"
      },
      "build_command": {
        "type": "string"
      },
      "start_command": {
        "type": "string"
      },
      "dockerfile_location": {
        "type": "string"
      },
      "watch_paths": {
        "type": "string"
      },
      "dockerfile_target_build": {
        "type": "string"
      },
      "delete_volumes": {
        "type": "boolean"
      },
      "pull_request_id": {
        "type": "number"
      }
    },
    "required": [
      "action"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
