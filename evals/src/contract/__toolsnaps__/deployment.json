{
  "name": "deployment",
  "description": "Manage deployment: get/cancel/list_for_app. Logs excluded by default on all actions — for get use `lines` (paginated tail), for list_for_app use `include_logs: true` to include raw build-log blobs.",
  "annotations": {
    "destructiveHint": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "get",
          "cancel",
          "list_for_app"
        ]
      },
      "uuid": {
        "type": "string"
      },
      "lines": {
        "type": "number"
      },
      "page": {
        "type": "number"
      },
      "max_chars": {
        "type": "number"
      },
      "include_logs": {
        "type": "boolean"
      }
    },
    "required": [
      "action",
      "uuid"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
