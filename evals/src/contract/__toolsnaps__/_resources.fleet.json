{
  "resources": [
    {
      "name": "api-gateway (default)",
      "title": "Application detail",
      "uri": "coolify://default/application/app-api",
      "description": "exited:unhealthy — https://api.example.test",
      "mimeType": "application/json"
    },
    {
      "name": "log-viewer (default)",
      "title": "Application detail",
      "uri": "coolify://default/application/app-logviewer",
      "description": "running:healthy — https://logs.example.test",
      "mimeType": "application/json"
    },
    {
      "name": "shop-frontend (default)",
      "title": "Application detail",
      "uri": "coolify://default/application/app-shop",
      "description": "running:healthy — https://shop.example.test",
      "mimeType": "application/json"
    },
    {
      "name": "default overview",
      "title": "Infrastructure overview",
      "uri": "coolify://default/overview",
      "description": "Every resource on the \"default\" instance.",
      "mimeType": "application/json"
    },
    {
      "name": "api-gateway (staging)",
      "title": "Application detail",
      "uri": "coolify://staging/application/app-api",
      "description": "exited:unhealthy — https://api.example.test",
      "mimeType": "application/json"
    },
    {
      "name": "log-viewer (staging)",
      "title": "Application detail",
      "uri": "coolify://staging/application/app-logviewer",
      "description": "running:healthy — https://logs.example.test",
      "mimeType": "application/json"
    },
    {
      "name": "shop-frontend (staging)",
      "title": "Application detail",
      "uri": "coolify://staging/application/app-shop",
      "description": "running:healthy — https://shop.example.test",
      "mimeType": "application/json"
    },
    {
      "name": "staging overview",
      "title": "Infrastructure overview",
      "uri": "coolify://staging/overview",
      "description": "Every resource on the \"staging\" instance.",
      "mimeType": "application/json"
    }
  ],
  "templates": [
    {
      "name": "application",
      "title": "Application detail",
      "uriTemplate": "coolify://{instance}/application/{uuid}",
      "description": "Full configuration and status for one application. Credentials are masked, as they are on `get_application` without `reveal`.",
      "mimeType": "application/json"
    },
    {
      "name": "overview",
      "title": "Infrastructure overview",
      "uriTemplate": "coolify://{instance}/overview",
      "description": "Counts and current status for every server, project, application, database and service. The same snapshot `get_infrastructure_overview` returns.",
      "mimeType": "application/json"
    }
  ]
}
