{
  "name": "projects",
  "description": "Manage projects: list/get/create/update/delete",
  "annotations": {
    "destructiveHint": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "get",
          "create",
          "update",
          "delete"
        ]
      },
      "uuid": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "page": {
        "type": "number"
      },
      "per_page": {
        "type": "number"
      }
    },
    "required": [
      "action"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
