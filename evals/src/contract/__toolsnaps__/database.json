{
  "name": "database",
  "description": "Manage database: create/update/delete. `update` is how you expose an existing database on a public port (`is_public` + `public_port`) or change limits/credentials.",
  "annotations": {
    "destructiveHint": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "delete"
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "postgresql",
          "mysql",
          "mariadb",
          "mongodb",
          "redis",
          "keydb",
          "clickhouse",
          "dragonfly"
        ]
      },
      "uuid": {
        "type": "string"
      },
      "server_uuid": {
        "type": "string"
      },
      "project_uuid": {
        "type": "string"
      },
      "environment_name": {
        "type": "string"
      },
      "destination_uuid": {
        "description": "Destination UUID. Required if server has multiple destinations.",
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "image": {
        "type": "string"
      },
      "is_public": {
        "description": "Expose on a public port. On update, true asks for confirmation first.",
        "type": "boolean"
      },
      "public_port": {
        "type": "number"
      },
      "public_port_timeout": {
        "description": "Update only",
        "type": "number"
      },
      "limits_memory": {
        "description": "Update only, e.g. \"512m\"",
        "type": "string"
      },
      "limits_memory_swap": {
        "description": "Update only",
        "type": "string"
      },
      "limits_memory_swappiness": {
        "description": "Update only",
        "type": "number"
      },
      "limits_memory_reservation": {
        "description": "Update only",
        "type": "string"
      },
      "limits_cpus": {
        "description": "Update only, e.g. \"1.5\"",
        "type": "string"
      },
      "limits_cpuset": {
        "description": "Update only",
        "type": "string"
      },
      "limits_cpu_shares": {
        "description": "Update only",
        "type": "number"
      },
      "instant_deploy": {
        "type": "boolean"
      },
      "delete_volumes": {
        "type": "boolean"
      },
      "postgres_user": {
        "type": "string"
      },
      "postgres_password": {
        "type": "string"
      },
      "postgres_db": {
        "type": "string"
      },
      "mysql_root_password": {
        "type": "string"
      },
      "mysql_user": {
        "type": "string"
      },
      "mysql_password": {
        "type": "string"
      },
      "mysql_database": {
        "type": "string"
      },
      "mariadb_root_password": {
        "type": "string"
      },
      "mariadb_user": {
        "type": "string"
      },
      "mariadb_password": {
        "type": "string"
      },
      "mariadb_database": {
        "type": "string"
      },
      "mongo_initdb_root_username": {
        "type": "string"
      },
      "mongo_initdb_root_password": {
        "type": "string"
      },
      "mongo_initdb_database": {
        "type": "string"
      },
      "redis_password": {
        "type": "string"
      },
      "keydb_password": {
        "type": "string"
      },
      "clickhouse_admin_user": {
        "type": "string"
      },
      "clickhouse_admin_password": {
        "type": "string"
      },
      "dragonfly_password": {
        "type": "string"
      }
    },
    "required": [
      "action"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
